        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {

    if (isLoading || !newValue) {
        return;
    }

    var ga = new GlideAjax('GetVendingMachineInfo');
    ga.addParam('sysparm_name', 'getMachineInfo');
    ga.addParam('sysparm_machine_id', newValue);

    ga.getXMLAnswer(function(response) {

        var data = JSON.parse(response);

        g_form.showFieldMsg(
            'vending_machine',
            'This machine was last serviced on ' +
            data.last_serviced +
            ' and is currently ' +
            data.state,
            'info'
        );
    });
}]]></script>
